   "source": [
    "from openai import OpenAI"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "a7142b1f-d612-4e79-96ce-6e408febd435",
   "metadata": {},
   "outputs": [],
   "source": [
    "endpoint = \"https://m2web-3608-resource.openai.azure.com/openai/v1/\"\n",
    "deployment_name = \"DeepSeek-V3.1\"\n",
    "api_key = \"<REDACTED_API_KEY>\""
   ]
  },
  {
   "cell_type": "raw",
   "id": "44a7ac04-5b0a-4df2-bc54-35e97fdc7f3a",
   "metadata": {},
   "source": [
    "client = OpenAI(\n",
    "    base_url=endpoint,\n",
    "    api_key=api_key\n",
    ")\n",
    "\n",
    "completion = client.chat.completions.create(\n",
    "    model=deployment_name,\n",
    "    messages=[\n",
    "        {\n",
    "            \"role\": \"user\",\n",
    "            \"content\": \"What is your favorite album from the rock trio from the great nation of Canada, Rush?\",\n",
    "        }\n",
    "    ],\n",
    "    temperature=0.7,\n",
    ")\n",
    "\n",
    "print(completion.choices[0].message)"
   ]
  },
